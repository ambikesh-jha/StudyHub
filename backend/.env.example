ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SHARE_LINK_EXPIRE_DAYS=7
# Local default. For production use: postgresql+asyncpg://studyhub:password@localhost:5432/studyhub
DATABASE_URL=sqlite+aiosqlite:///./studyhub.db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
API_BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
STATIC_URL_PREFIX=/uploads
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_LOGIN=5/minute
REDIS_URL=redis://localhost:6379/0
MAIL_FROM=noreply@study-hub.local
VITE_API_BASE_URL=http://localhost:8000
